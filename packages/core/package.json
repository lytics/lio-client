{
  "name": "@lytics/lio-client",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for the Lytics API - plugin-based client for all Lytics integrations",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["lytics", "sdk", "api-client", "content", "analytics"],
  "repository": {
    "type": "git",
    "url": "https://github.com/lytics/lio-client.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}