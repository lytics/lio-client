{
  "name": "@lytics/lio-client",
  "version": "0.2.0",
  "description": "TypeScript/JavaScript SDK for the Lytics API - plugin-based client for all Lytics integrations",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "lytics",
    "sdk",
    "api-client",
    "content",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lytics/lio-client.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lytics/sdk-kit": "^0.2.0",
    "@lytics/sdk-kit-plugins": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}