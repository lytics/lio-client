{
  "name": "@lytics/lio-client-contentstack-brand-kit",
  "version": "0.1.0",
  "description": "Contentstack Brand Kit and Knowledge Vault plugin for Lytics lio-client",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "lytics",
    "contentstack",
    "brand-kit",
    "knowledge-vault"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lytics/lio-client.git",
    "directory": "packages/contentstack-brand-kit"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lytics/sdk-kit": "^0.2.0"
  },
  "peerDependencies": {
    "@lytics/lio-client": "workspace:*"
  },
  "devDependencies": {
    "@lytics/lio-client": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
